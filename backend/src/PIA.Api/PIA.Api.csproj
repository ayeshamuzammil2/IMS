<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PIA.Api</RootNamespace>
    <UserSecretsId>pia-internship-system-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PIA.Infrastructure\PIA.Infrastructure.csproj" />
    <ProjectReference Include="..\PIA.Application\PIA.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="AspNetCore.HealthChecks.MySql" />
    <!--
      Design-time only: `dotnet ef` requires this on the STARTUP project even though PiaDbContext
      lives in PIA.Infrastructure. PrivateAssets keeps it out of the published output and it
      exposes no runtime EF Core APIs, so it doesn't compromise the "Api can't touch EF" boundary.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
