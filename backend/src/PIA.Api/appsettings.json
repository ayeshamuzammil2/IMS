{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pia-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PIA.InternshipSystem",
    "Audience": "PIA.InternshipSystem.Client",
    "FullTokenLifetimeMinutes": 60,
    "RestrictedTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },
  "PasswordPolicy": {
    "MinLength": 10,
    "MaxLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSymbol": true
  },
  "LoginLockout": {
    "MaxFailedAttempts": 5,
    "InitialLockoutMinutes": 15,
    "MaxLockoutMinutes": 60
  },
  "AdminSeed": {
    "Email": "pia@admin.com",
    "Password": "Admin@12345"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Port": 587,
    "FromAddress": "no-reply@pia-internship.local",
    "FromName": "PIA Internee Management",
    "UseStartTls": true
  },
  "Attendance": {
    "LateGraceMinutes": 15,
    "EarlyLeaveGraceMinutes": 15,
    "SessionTtlSeconds": 90,
    "SelfieRetentionDays": 180,
    "EarliestMarkHourLocal": 5,
    "LatestMarkHourLocal": 23,
    "OverrideMonthlyQuota": 3,
    "MinOverrideJustificationLength": 20
  },
  "Face": {
    "ModelsPath": "Assets/Models",
    "EmbeddingModelFileName": "facenet.onnx",
    "PadModelFileName": "minifasnet.onnx",
    "EmbeddingInputSize": 160,
    "PadInputSize": 80,
    "PadCropScale": 2.7,
    "MatchThreshold": 0.62,
    "PadLiveThreshold": 0.85,
    "PadReplayHardFailThreshold": 0.4,
    "EnrollmentCrossMatchThreshold": 0.55,
    "EnrollmentRefreshCooldownDays": 30,
    "ParallaxMinYawSwingDegrees": 15,
    "ParallaxLiveResidualRatio": 0.015,
    "ParallaxPlaneResidualRatio": 0.005,
    "RiskReviewThreshold": 60,
    "RiskHardFailThreshold": 80
  },
  "Certificates": {
    "LibreOfficeExecutable": "soffice",
    "ConversionTimeoutSeconds": 30
  },
  "PlayIntegrity": {
    "Mode": "Off",
    "PackageName": "com.pia.internship",
    "ServiceAccountJsonPath": "Assets/Secrets/play-integrity-service-account.json"
  }
}
