<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core / Data -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.2" />

    <!-- Auth / Security -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.9.2" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />

    <!-- Email (bumped past 4.7.1 / 5.10.0 - both had known moderate-to-critical CVEs flagged on first restore) -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Scriban" Version="7.2.6" />

    <!-- Documents / PDF -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageVersion Include="QuestPDF" Version="2024.10.2" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="SkiaSharp" Version="2.88.8" />

    <!--
      Face / ML (added in Phase 5). FaceONNX.Models is NOT a real NuGet package - the model
      weights ship as split .rar archives from the FaceONNX GitHub repo / Google Drive, per the
      research done during planning. Phase 5 downloads them directly into
      PIA.Infrastructure/Assets/Models/ instead of via a package reference.
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <PackageVersion Include="FaceONNX" Version="4.1.1.3" />

    <!-- Jobs / Time -->
    <PackageVersion Include="Cronos" Version="0.8.4" />
    <PackageVersion Include="TimeZoneConverter" Version="6.1.0" />

    <!-- Export -->
    <PackageVersion Include="CsvHelper" Version="33.0.1" />

    <!-- API / Infra -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.MySql" Version="8.0.1" />

    <!-- Cloud (optional / paid provider swap, wired in Phase 9) -->
    <PackageVersion Include="AWSSDK.Rekognition" Version="3.7.400.9" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="3.7.400.44" />
    <PackageVersion Include="Google.Apis.PlayIntegrity.v1" Version="1.68.0.3618" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="3.10.0" />
  </ItemGroup>

</Project>
